#!/bin/sh /etc/rc.common
# procd service for the combined tailscale binary built by build.sh.
# NOTE: the hook must be lowercase start_service — START_SERVICE is not
# recognized by /etc/rc.common and silently starts nothing.
START=99
STOP=1
USE_PROCD=1

start_service() {
    mkdir -p /var/lib/tailscale /var/run/tailscale
    procd_open_instance
    procd_set_param command /usr/sbin/tailscaled \
        --state /var/lib/tailscale/tailscaled.state \
        --socket /var/run/tailscale/tailscaled.sock
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-0}
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
